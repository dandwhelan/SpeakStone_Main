<Bindings>
  <Binding name="PLAYACTIVEQUEST" default="F6" header="SPEAKSTONE">
    PlayQuestAudio(nil, true)
  </Binding>
  <Binding name="SPEAKSTONEPAUSE">
    SpeakStone_TogglePause()
  </Binding>
  <Binding name="SPEAKSTONESTOP">
    SpeakStone_Stop()
  </Binding>
  <Binding name="SPEAKSTONENEXT">
    SpeakStone_Next()
  </Binding>
  <Binding name="SPEAKSTONEPREVIOUS">
    SpeakStone_Previous()
  </Binding>
  <Binding name="SPEAKSTONEREPLAY">
    SpeakStone_Replay()
  </Binding>
  <Binding name="SPEAKSTONEPADFOCUS">
    SpeakStone_ControllerFocus()
  </Binding>
</Bindings>
